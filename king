(function (global) {
    'use strict';

    var Zorio = global.Zorio = global.Zorio || {};

    function PlaylistsView(app) {
        this._app = app;
        this._root = null;
        this._net = new Zorio.NetworkClient();
    }

    PlaylistsView.prototype.mount = function (container) {
        container.innerHTML = Zorio.Templates.get('playlists');
        this._root = container.firstElementChild;
        this.refreshView();
    };

    PlaylistsView.prototype.refreshView = function () {
        if (!this._root) return;

        var epgUrlEl = this._root.querySelector('[data-zorio-epg-url]');
        var epgStatus = Zorio.epgService.getStatus();
        if (epgUrlEl) {
            if (!epgStatus.url) epgUrlEl.textContent = 'Джерело EPG не підключено';
            else if (epgStatus.status === 'loading') epgUrlEl.textContent = 'Завантаження EPG: ' + epgStatus.url;
            else if (epgStatus.status === 'error') epgUrlEl.textContent = 'Помилка EPG (' + epgStatus.error + '): ' + epgStatus.url;
            else if (epgStatus.status === 'ready') epgUrlEl.textContent = 'Активно (' + epgStatus.programmeCount + ' передач): ' + epgStatus.url;
            else epgUrlEl.textContent = epgStatus.url;
        }

        var gridEl = this._root.querySelector('[data-zorio-playlists-grid]');
        if (!gridEl) return;

        Zorio.playlistService.ensureDefaultPlaylist();
        var playlists = Zorio.playlistService.getPlaylists();
        var activeId = Zorio.playlistService.getActivePlaylistId();

        var html = '';

        if (playlists.length > 1) {
            var allActive = activeId === 'all';
            html += '<div class="zorio-pl-card' + (allActive ? ' is-active' : '') + '">' +
                '<div class="zorio-pl-card__head">' +
                    '<div class="zorio-pl-card__name">Усі підключені плейлисти</div>' +
                    '<span class="zorio-pl-card__status is-ok">' + (allActive ? 'Активний режим' : 'Об’єднаний перегляд') + '</span>' +
                '</div>' +
                '<div class="zorio-pl-card__stats">' +
                    '<div>Джерел: <strong>' + playlists.length + '</strong></div>' +
                    '<div>Режим: <strong>Мульти-плейлист</strong></div>' +
                '</div>' +
                '<div class="zorio-pl-card__btns">' +
                    '<div class="zorio-btn-secondary zorio-focusable" data-action="activate-playlist" data-id="all">' + (allActive ? '✓ Обрано' : 'Дивитись усі разом') + '</div>' +
                '</div>' +
            '</div>';
        }

        for (var i = 0; i < playlists.length; i++) {
            var pl = playlists[i];
            var isAct = activeId === pl.id || (playlists.length === 1 && activeId === 'all');
            var stCls = pl.status === 'ok'
                ? 'is-ok'
                : (pl.status === 'loading' || pl.status === 'cached' ? 'is-loading' : 'is-err');
            var stLabel = pl.status === 'ok'
                ? 'Підключено'
                : (pl.status === 'loading' ? 'Оновлення…' : (pl.status === 'cached' ? 'Збережений кеш' : (pl.error || 'Помилка')));
            var typeLabel = pl.isDefault
                ? 'Вбудоване джерело (UA)'
                : (pl.type === 'file' ? 'Локальний M3U' : 'Користувацький URL');

            html += '<div class="zorio-pl-card' + (isAct ? ' is-active' : '') + '">' +
                '<div class="zorio-pl-card__head">' +
                    '<div class="zorio-pl-card__name">' + Zorio.Utils.escapeHtml(pl.name) + '</div>' +
                    '<span class="zorio-pl-card__status ' + stCls + '">' + Zorio.Utils.escapeHtml(stLabel) + '</span>' +
                '</div>' +
                '<div class="zorio-pl-card__stats">' +
                    '<div>Тип: <strong>' + typeLabel + '</strong></div>' +
                    '<div>Каналів: <strong>' + (pl.channelCount || 0) + '</strong></div>' +
                    '<div>Оновлено: <strong>' + Zorio.Utils.escapeHtml(Zorio.Utils.formatDateTime(pl.updatedAt)) + '</strong></div>' +
                '</div>' +
                '<div class="zorio-pl-card__url">' + Zorio.Utils.escapeHtml(pl.url || '') + '</div>' +
                '<div class="zorio-pl-card__btns">' +
                    '<div class="zorio-btn-secondary zorio-focusable" data-action="activate-playlist" data-id="' + Zorio.Utils.escapeHtml(pl.id) + '">' + (isAct ? '✓ Активний' : 'Обрати') + '</div>' +
                    '<div class="zorio-btn-secondary zorio-focusable" data-action="refresh-playlist" data-id="' + Zorio.Utils.escapeHtml(pl.id) + '">Оновити</div>' +
                    (pl.isDefault ? '' : '<div class="zorio-btn-secondary zorio-btn-danger zorio-focusable" data-action="delete-playlist" data-id="' + Zorio.Utils.escapeHtml(pl.id) + '">Видалити</div>') +
                '</div>' +
            '</div>';
        }

        gridEl.innerHTML = html;
    };

    PlaylistsView.prototype._promptText = function (title, initialValue, onDone) {
        var self = this;
        if (typeof Lampa !== 'undefined' && Lampa.Input && typeof Lampa.Input.edit === 'function') {
            Lampa.Input.edit({ title: title, value: initialValue || '', free: true, nosave: true }, function (val) {
                self._app.restoreFocus();
                if (onDone) onDone(Zorio.Utils.trim(val));
            });
            return;
        }
        var res = typeof global.prompt === 'function' ? global.prompt(title, initialValue || '') : '';
        if (onDone) onDone(Zorio.Utils.trim(res || ''));
    };

    PlaylistsView.prototype._notify = function (text) {
        if (typeof Lampa !== 'undefined' && Lampa.Noty && Lampa.Noty.show) Lampa.Noty.show(text);
    };

    PlaylistsView.prototype.onAction = function (el) {
        var self = this;
        var action = el.getAttribute('data-action');
        var id = el.getAttribute('data-id');

        if (action === 'back-to-tv') {
            this._app.showView('tv');
            return true;
        }
        if (action === 'add-playlist-url') {
            this._promptText('Введіть URL додаткового плейлиста (.m3u / .m3u8)', '', function (url) {
                if (!url) return;
                if (!Zorio.Utils.isValidUrl(url)) {
                    self._notify('Некоректне посилання на плейлист');
                    return;
                }
                self._promptText('Введіть назву плейлиста', 'Мій IPTV плейлист', function (name) {
                    self._notify('Завантаження плейлиста…');
                    Zorio.playlistService.addUrlPlaylist(name || 'IPTV плейлист', url, function (ok, msg) {
                        self._notify((ok ? '✓ ' : '✗ ') + msg);
                        self.refreshView();
                    });
                });
            });
            return true;
        }
        if (action === 'add-playlist-file') {
            this._net.pickLocalFile('.m3u,.m3u8', function (file) {
                Zorio.playlistService.addFilePlaylist(file.name, file.content, function (ok, msg) {
                    self._notify((ok ? '✓ ' : '✗ ') + msg);
                    self.refreshView();
                });
            }, function (errMsg) {
                self._notify(errMsg);
            });
            return true;
        }
        if (action === 'refresh-all-playlists') {
            self._notify('Оновлення всіх плейлистів…');
            Zorio.playlistService.refreshAll(function (okCount, total) {
                self._notify('Оновлено плейлистів: ' + okCount + ' з ' + total);
                self.refreshView();
            });
            return true;
        }
        if (action === 'set-epg-url') {
            this._promptText('Введіть URL телепрограми XMLTV (.xml)', Zorio.Storage.getEpgUrl(), function (url) {
                Zorio.Storage.setEpgUrl(url);
                if (!url) {
                    self._notify('Посилання на EPG очищено');
                    self.refreshView();
                    return;
                }
                self._notify('Завантаження EPG…');
                Zorio.epgService.load(url, function (ok, msg) {
                    self._notify((ok ? '✓ ' : '✗ ') + msg);
                    self.refreshView();
                });
            });
            return true;
        }
        if (action === 'refresh-epg') {
            var epgUrl = Zorio.Storage.getEpgUrl();
            if (!epgUrl) { self._notify('Спочатку вкажіть URL телепрограми EPG'); return true; }
            self._notify('Оновлення EPG…');
            Zorio.epgService.load(epgUrl, function (ok, msg) {
                self._notify((ok ? '✓ ' : '✗ ') + msg);
                self.refreshView();
            });
            return true;
        }
        if (action === 'activate-playlist' && id) {
            Zorio.playlistService.setActivePlaylist(id);
            self._notify('Активний плейлист змінено');
            self.refreshView();
            return true;
        }
        if (action === 'refresh-playlist' && id) {
            self._notify('Оновлення плейлиста…');
            Zorio.playlistService.refreshPlaylist(id, function (ok, msg) {
                self._notify((ok ? '✓ ' : '✗ ') + msg);
                self.refreshView();
            });
            return true;
        }
        if (action === 'delete-playlist' && id) {
            if (Zorio.playlistService.removePlaylist(id)) self._notify('Плейлист видалено');
            else self._notify('Вбудований плейлист не можна видалити');
            self.refreshView();
            return true;
        }
        return false;
    };

    PlaylistsView.prototype.unmount = function () {
        this._root = null;
    };

    Zorio.PlaylistsView = PlaylistsView;
})(typeof window !== 'undefined' ? window : global);


