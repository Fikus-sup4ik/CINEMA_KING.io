    function esc(str) {
        if (str === null || str === undefined) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function formatCardNumber(num) {
        var digits = String(num || '').replace(/\s+/g, '');
        if (!digits) return '';
        return digits.replace(/(.{4})/g, '$1 ').trim();
    }

    function copyTextToClipboard(text, onSuccess) {
        var str = String(text || '').trim();
        if (!str) return;
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
            navigator.clipboard.writeText(str).then(function () {
                if (onSuccess) onSuccess();
            }, function () {
                fallbackCopy(str, onSuccess);
            });
        } else {
            fallbackCopy(str, onSuccess);
        }
    }

    function fallbackCopy(str, onSuccess) {
        try {
            var ta = document.createElement('textarea');
            ta.value = str;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            if (onSuccess) onSuccess();
        } catch (e) {}
    }

    function openExternalUrl(url, showToastFn) {
        var clean = String(url || '').trim();
        if (!clean) return;
        if (!/^https?:\/\//i.test(clean) && !/^tg:\/\//i.test(clean)) {
            clean = 'https://' + clean;
        }
        try {
            var win = window.open(clean, '_blank');
            if (!win) {
                copyTextToClipboard(clean, function () {
                    if (showToastFn) showToastFn('Ссылка скопирована: ' + clean);
                });
            }
        } catch (e) {
            copyTextToClipboard(clean, function () {
                if (showToastFn) showToastFn('Ссылка скопирована: ' + clean);
            });
        }
    }

