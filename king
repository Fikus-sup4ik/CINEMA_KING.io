    function startRouletteSpin(spinBtn, viewport, track) {
        isRouletteSpinning = true;
        spinBtn.addClass('is-disabled').text('ПОДБИРАЕМ...');

        fetchRouletteCandidates(function (available, allCached) {
            if (activeTab !== 'roulette') {
                isRouletteSpinning = false;
                return;
            }

            var winner = available[Math.floor(Math.random() * available.length)];
            rouletteSeen[cardKey(winner)] = true;
            roulettePreviewPool = allCached.slice(0, 18);

            var reelData = buildRouletteReel(allCached, winner);
            track.empty();
            track.css('transform', 'translate3d(0px, 0px, 0px)');

            for (var i = 0; i < reelData.items.length; i++) {
                var item = reelData.items[i];
                var imgHtml = item.poster
                    ? '<img src="' + esc(item.poster) + '" alt="' + esc(item.title) + '">'
                    : '<div class="ck-poster-fallback" style="font-size:1.5em;">' + esc(getInitials(item.title)) + '</div>';
                var slot = $(
                    '<div class="ck-rl-item" data-idx="' + i + '">' +
                        imgHtml +
                        '<div class="ck-rl-item-label">' + esc(item.title) + '</div>' +
                    '</div>'
                );
                slot.find('img').on('error', function () {
                    $(this).replaceWith('<div class="ck-poster-fallback" style="font-size:1.5em;">CK</div>');
                });
                track.append(slot);
            }

            spinBtn.text('ВРАЩАЕТСЯ...');

            var firstSlot = track.find('.ck-rl-item').eq(0);
            var secondSlot = track.find('.ck-rl-item').eq(1);
            var slotWidth = firstSlot.outerWidth() || 170;
            var stepPx = secondSlot.length ? (secondSlot.position().left - firstSlot.position().left) : (slotWidth + 14);
            var vpWidth = viewport.innerWidth() || 800;

            var targetCenter = (reelData.winnerIndex * stepPx) + (slotWidth / 2);
            var finalTranslateX = (vpWidth / 2) - targetCenter;

            var duration = isReducedMotion(state) ? 450 : 4100;
            var startTime = null;

            function finishSpin() {
                isRouletteSpinning = false;
                rouletteRafId = null;

                var winSlot = track.find('.ck-rl-item').eq(reelData.winnerIndex);
                winSlot.addClass('is-winner');
                updateCardBackdrop(winner);
                spinBtn.text('ВЫБРАНО!');

                var revealDelay = isReducedMotion(state) ? 150 : 750;
                setTimeout(function () {
                    if (activeTab === 'roulette') {
                        rouletteResult = winner;
                        renderRouletteResultModal(winner);
                    }
                }, revealDelay);
            }

            function stepFrame(timestamp) {
                if (!startTime) startTime = timestamp;
                var elapsed = timestamp - startTime;
                var progress = Math.min(1, elapsed / duration);
                var eased = 1 - Math.pow(1 - progress, 3);
                var currentX = finalTranslateX * eased;

                track.css('transform', 'translate3d(' + currentX.toFixed(1) + 'px, 0px, 0px)');

                if (progress < 1 && activeTab === 'roulette') {
                    rouletteRafId = requestAnimationFrame(stepFrame);
                } else {
                    finishSpin();
                }
            }

            rouletteRafId = requestAnimationFrame(stepFrame);
        }, function (errMsg) {
            isRouletteSpinning = false;
            spinBtn.removeClass('is-disabled').text('КРУТИТЬ');
            showToast(errMsg);
        });
    }

