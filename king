            retryBtn.on('hover:enter', function () {
                if (onRetry) onRetry();
            });
            box.append(retryBtn);
            body.empty().append(box);
            refreshFocus(retryBtn);
        }

        // ---------------------------------------------------------------------
        // ЖИЗНЕННЫЙ ЦИКЛ КОМПОНЕНТА LAMPA
        // ---------------------------------------------------------------------

        this.create = function () {
            injectStyles();
            applyMotionClass();
            contentWrap.append(topbar).append(body).append(footerSig);
            html.append(contentWrap);
            scroll.append(html);
            shell.append(bgStage).append(scroll.render());
            $('body').append(toastEl);

            shell.on('wheel.ck', function (e) {
                var orig = e.originalEvent || e;
                var delta = orig.deltaY || 0;
                if (delta !== 0 && typeof scroll.wheel === 'function') {
                    scroll.wheel(delta > 0 ? 120 : -120);
                }
            });

            renderTopbar();
            renderHome();
            return this.render();
        };

        this.start = function () {
            Lampa.Controller.add('content', {
                toggle: function () {
                    Lampa.Controller.collectionSet(html);
                    Lampa.Controller.collectionFocus(lastFocused || false, html);
                },
                left: function () {
                    if (Navigator.canmove('left')) Navigator.move('left');
                    else Lampa.Controller.toggle('menu');
                },
                right: function () {
                    if (Navigator.canmove('right')) Navigator.move('right');
                },
                up: function () {
                    if (Navigator.canmove('up')) Navigator.move('up');
                    else Lampa.Controller.toggle('head');
                },
                down: function () {
                    if (Navigator.canmove('down')) Navigator.move('down');
                },
                back: function () {
                    if (isRouletteSpinning) return;
                    if (activeTab === 'roulette' && rouletteResult) {
                        rouletteResult = null;
                        renderRoulette();
                    } else if (activeTab === 'roulette' && state.roulette.streamMode) {
                        state.roulette.streamMode = false;
                        StorageManager.save(state);
                        renderRoulette();
                    } else if (activeTab === 'wizard' && wizardStep > 1) {
                        wizardStep -= 1;
                        renderWizard();
                    } else if (activeTab !== 'home') {
                        switchTab('home');
                    } else {
                        Lampa.Activity.backward();
                    }
                }
            });

            Lampa.Controller.toggle('content');
        };

        this.pause = function () {
            backdropMgr.stopSlideshow();
            stopRouletteAnimation();
        };

        this.stop = function () {
            backdropMgr.stopSlideshow();
            stopRouletteAnimation();
        };

        this.render = function () {
            return shell;
        };

        this.destroy = function () {
            clearTimeout(toastTimer);
            stopRouletteAnimation();
            backdropMgr.destroy();
            shell.off('wheel.ck');
            network.clear();
            scroll.destroy();
            toastEl.remove();
            shell.remove();
        };
    }

    // =========================================================================
    // РЕГИСТРАЦИЯ ПЛАГИНА И КНОПКИ «CINEMA KING» В ГЛАВНОМ МЕНЮ LAMPA
    // =========================================================================

    function addMenuButton() {
        var menuList = $('.menu .menu__list').eq(0);
        if (!menuList.length) return false;
        if (menuList.find('.ck-menu-item').length) return true;

        var icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18h20L20 7l-5 4-3-6-3 6-5-4-2 11z"/></svg>';

        var item = $(
            '<li class="menu__item selector ck-menu-item">' +
                '<div class="menu__ico">' + icon + '</div>' +
                '<div class="menu__text">Cinema King</div>' +
            '</li>'
        );

        item.on('hover:enter', function () {
            Lampa.Activity.push({
                url: '',
                title: 'Cinema King',
                component: PLUGIN_ID,
                page: 1
            });
        });

        menuList.append(item);
        return true;
    }

    function ensureMenuButtonMounted() {
        if (addMenuButton()) return;
        var attempts = 0;
        var timer = setInterval(function () {
            attempts += 1;
            if (addMenuButton() || attempts >= 50) {
                clearInterval(timer);
            }
        }, 300);
    }

    function initPlugin() {
        Lampa.Component.add(PLUGIN_ID, CinemaKingComponent);
        ensureMenuButtonMounted();
    }

    if (window.appready) {
        initPlugin();
    } else {
        Lampa.Listener.follow('app', function (e) {
            if (e.type === 'ready') initPlugin();
        });
    }

    if (!window.cinema_king_menu_listener) {
        window.cinema_king_menu_listener = true;
        Lampa.Listener.follow('menu', function () {
            addMenuButton();
        });
    }
})();
