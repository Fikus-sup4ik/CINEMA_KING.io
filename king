        Zorio.events.emit('playlists:updated', { playlists: playlists });
        Zorio.events.emit('catalog:changed', {});
        if (cb) cb(true, 'Завантажено каналів: ' + pl.channelCount, pl);
    };

    PlaylistService.prototype.refreshPlaylist = function (id, cb) {
        var self = this;
        var playlists = this.getPlaylists();
        var target = null;
        for (var i = 0; i < playlists.length; i++) {
            if (playlists[i].id === id) { target = playlists[i]; break; }
        }
        if (!target) { if (cb) cb(false, 'Плейлист не знайдено'); return; }

        if (target.type === 'smart') {
            this._refreshSmartPlaylist(target, cb);
            return;
        }

        if (target.type === 'file') {
            var parsedFile = Zorio.M3UParser.parse(target.rawContent, { playlistId: target.id, addedAt: target.updatedAt || Date.now() });
            if (parsedFile.ok) {
                self._storeParsed(target, parsedFile, null, false);
                Zorio.Storage.savePlaylists(playlists);
                Zorio.events.emit('playlists:updated', { playlists: playlists });
                Zorio.events.emit('catalog:changed', {});
                if (cb) cb(true, 'Локальний плейлист оновлено');
            } else {
                target.status = 'error';
                target.error = parsedFile.error;
                Zorio.Storage.savePlaylists(playlists);
                Zorio.events.emit('playlists:updated', { playlists: playlists });
                if (cb) cb(false, parsedFile.error);
            }
            return;
        }

        this._loadingIds[id] = true;
        target.status = 'loading';
        target.error = '';
        Zorio.Storage.savePlaylists(playlists);
        Zorio.events.emit('playlists:updated', { playlists: playlists });

        this._net.fetchText(target.url, function (text) {
            delete self._loadingIds[id];
            var parsed = Zorio.M3UParser.parse(text, { playlistId: target.id, addedAt: Date.now() });
            var freshList = self.getPlaylists();
            var item = null;
            for (var j = 0; j < freshList.length; j++) {
                if (freshList[j].id === id) { item = freshList[j]; break; }
            }
            if (!item) return;

            if (!parsed.ok) {
                var hadCache = self._loadFromCacheIfAvailable(item) || !!(self._itemsByPlaylist[id] && self._itemsByPlaylist[id].length);
                item.status = hadCache ? 'cached' : 'error';
                item.error = hadCache ? 'Оновлення не вдалося — показано збережений список' : parsed.error;
                Zorio.Storage.savePlaylists(freshList);
                Zorio.events.emit('playlists:updated', { playlists: freshList });
                Zorio.events.emit('catalog:changed', { fallback: hadCache });
                if (cb) cb(false, item.error);
                return;
            }

            self._storeParsed(item, parsed, text, false);
            Zorio.Storage.savePlaylists(freshList);
            Zorio.events.emit('playlists:updated', { playlists: freshList });
            Zorio.events.emit('catalog:changed', {});
            if (cb) cb(true, 'Оновлено каналів: ' + item.channelCount);
        }, function (errMsg) {
            delete self._loadingIds[id];
            var freshList = self.getPlaylists();
            var failedItem = null;
            for (var k = 0; k < freshList.length; k++) {
                if (freshList[k].id === id) { failedItem = freshList[k]; break; }
            }
            if (failedItem) {
                var hasCached = self._loadFromCacheIfAvailable(failedItem) || !!(self._itemsByPlaylist[id] && self._itemsByPlaylist[id].length);
                failedItem.status = hasCached ? 'cached' : 'error';
                failedItem.error = hasCached ? 'Джерело недоступне — використовується кеш' : (errMsg || 'URL недоступний');
                Zorio.Storage.savePlaylists(freshList);
                Zorio.events.emit('playlists:updated', { playlists: freshList });
                Zorio.events.emit('catalog:changed', { fallback: hasCached });
                if (cb) cb(false, failedItem.error);
            } else if (cb) {
                cb(false, errMsg || 'URL недоступний');
            }
        });
    };

    PlaylistService.prototype.refreshAll = function (cb) {
        var playlists = this.getPlaylists();
        if (!playlists.length) { if (cb) cb(0, 0); return; }
        var done = 0;
        var okCount = 0;
        for (var i = 0; i < playlists.length; i++) {
            this.refreshPlaylist(playlists[i].id, function (ok) {
                done += 1;
                if (ok) okCount += 1;
                if (done >= playlists.length && cb) cb(okCount, playlists.length);
            });
        }
    };

    PlaylistService.prototype.removePlaylist = function (id) {
        var playlists = this.getPlaylists();
        var next = [];
        for (var i = 0; i < playlists.length; i++) {
            if (playlists[i].id === id) {
                if (playlists[i].isDefault) next.push(playlists[i]);
                continue;
            }
            next.push(playlists[i]);
        }
        if (next.length !== playlists.length) {
            delete this._itemsByPlaylist[id];
            Zorio.Storage.removePlaylistCache(id);
            this._catalogCache = null;
            Zorio.Storage.savePlaylists(next);
            if (this.getActivePlaylistId() === id) Zorio.Storage.setActivePlaylistId('all');
            Zorio.events.emit('playlists:updated', { playlists: next });
            Zorio.events.emit('catalog:changed', {});
            return true;
        }
        return false;
    };

    PlaylistService.prototype.init = function () {
        var self = this;
        var t0 = Date.now();
        if (Zorio.smartCache) Zorio.smartCache.pruneStale();
        this.ensureDefaultPlaylist();
        var playlists = this.getPlaylists();
        var settings = Zorio.Storage.getSettings();
        var updateHours = settings.autoUpdateHours > 0 ? settings.autoUpdateHours : 24;
        var maxAgeMs = settings.autoUpdateHours === 0 ? 0 : updateHours * 3600 * 1000;
        var now = Date.now();
        var anyLoadedFromCache = false;
        var totalCachedCount = 0;

        for (var i = 0; i < playlists.length; i++) {
            var pl = playlists[i];
            var loadedCache = this._loadFromCacheIfAvailable(pl);
            if (loadedCache) {
                anyLoadedFromCache = true;
                totalCachedCount += (this._itemsByPlaylist[pl.id] ? this._itemsByPlaylist[pl.id].length : 0);
            }

            if (pl.type === 'smart' || pl.type === 'url') {
                var hasMemory = !!(this._itemsByPlaylist[pl.id] && this._itemsByPlaylist[pl.id].length);
                var stale = maxAgeMs > 0 && (!pl.updatedAt || (now - pl.updatedAt) > maxAgeMs);
                if (!hasMemory) {
                    this.refreshPlaylist(pl.id);
                } else if (stale) {
                    // Defer background refresh so cached catalog renders immediately without blocking Smart TV UI
                    (function (pid) {
                        setTimeout(function () { self.refreshPlaylist(pid); }, 800);
                    })(pl.id);
                }
            }
        }

        if (anyLoadedFromCache && Zorio.ottMetrics) {
            Zorio.ottMetrics.recordCatalogCacheLoad(Date.now() - t0, totalCachedCount);
        }

        this._initialized = true;
        this._catalogCache = null;
    };

    PlaylistService.prototype.getAllRawChannels = function () {
        var playlists = this.getPlaylists();
        var all = [];
        for (var i = 0; i < playlists.length; i++) {
            var items = this._itemsByPlaylist[playlists[i].id] || [];
            for (var j = 0; j < items.length; j++) all.push(items[j]);
        }
        return all;
    };

    PlaylistService.prototype.getAvailableCountries = function () {
        var catalog = this.getCatalog();
        var channels = catalog.channels || [];
        var counts = {};
        for (var i = 0; i < channels.length; i++) {
            var cc = channels[i].country || 'INT';
            counts[cc] = (counts[cc] || 0) + 1;
        }
        var list = [{ code: 'ALL', label: Zorio.Utils.getCountryLabel('ALL'), count: channels.length }];
        var keys = Object.keys(counts).sort(function (a, b) {
            if (a === 'UA') return -1;
            if (b === 'UA') return 1;
            return counts[b] - counts[a];
        });
        for (var k = 0; k < keys.length; k++) {
            list.push({
                code: keys[k],
                label: Zorio.Utils.getCountryLabel(keys[k]),
                count: counts[keys[k]]
            });
        }
        return list;
    };

    PlaylistService.prototype.getAvailableLanguages = function () {
        var catalog = this.getCatalog();
        var channels = catalog.channels || [];
        var counts = {};
        for (var i = 0; i < channels.length; i++) {
            var lang = channels[i].language || '';
            if (!lang) continue;
            counts[lang] = (counts[lang] || 0) + 1;
        }
        var list = [{ code: 'ALL', label: Zorio.Utils.getLanguageLabel('ALL'), count: channels.length }];
        var keys = Object.keys(counts).sort(function (a, b) {
            if (a === 'ukr') return -1;
            if (b === 'ukr') return 1;
            return counts[b] - counts[a];
        });
        for (var k = 0; k < keys.length; k++) {
            list.push({
                code: keys[k],
                label: Zorio.Utils.getLanguageLabel(keys[k]),
                count: counts[keys[k]]
            });
        }
        return list;
    };

    PlaylistService.prototype.getAvailableQualities = function () {
        var catalog = this.getCatalog();
        var channels = catalog.channels || [];
        var counts = { '4K': 0, '1080P': 0, '720P': 0, 'HD': 0, 'SD': 0 };
        for (var i = 0; i < channels.length; i++) {
            var q = String(channels[i].qualityTag || '').toUpperCase();
            if (q === '4K' || q === 'UHD' || q === '2160P') counts['4K'] += 1;
            else if (q === '1080P' || q === 'FHD') counts['1080P'] += 1;
            else if (q === '720P') counts['720P'] += 1;
            else if (q === 'HD') counts['HD'] += 1;
            else if (q === '576P' || q === '480P' || q === '360P') counts['SD'] += 1;
        }
        var list = [{ code: 'ALL', label: 'Уся якість', count: channels.length }];
        var order = ['4K', '1080P', '720P', 'HD', 'SD'];
        for (var j = 0; j < order.length; j++) {
            if (counts[order[j]] > 0) {
                list.push({ code: order[j], label: order[j], count: counts[order[j]] });
            }
        }
        return list;
    };

    PlaylistService.prototype.getCatalog = function () {
        if (this._catalogCache) return this._catalogCache;

        var activeId = this.getActivePlaylistId();
        var playlists = this.getPlaylists();
        var batches = [];

        for (var i = 0; i < playlists.length; i++) {
            var pl = playlists[i];
            if (activeId !== 'all' && pl.id !== activeId) continue;
            var items = this._itemsByPlaylist[pl.id] || [];
            if (items.length) {
                batches.push({
                    sourceId: pl.id,
                    sourceName: pl.name,
                    provider: pl.name,
                    playlistId: pl.id,
                    priority: pl.isDefault ? 1 : 10,
                    items: items
                });
            }
        }

        var combined = [];
        if (batches.length === 1) {
            combined = batches[0].items;
        } else if (batches.length > 1 && Zorio.SmartPlaylistMerger) {
            combined = Zorio.SmartPlaylistMerger.merge(batches);
        }

        var classified = Zorio.CatalogClassifier.classify(combined);
        for (var c = 0; c < classified.channels.length; c++) {
            classified.channels[c].displayNumber = c + 1;
        }

        this._catalogCache = classified;
        return classified;
    };

    PlaylistService.prototype.destroy = function () {
        this._net.clear();
    };

    Zorio.PlaylistService = PlaylistService;
    Zorio.playlistService = new PlaylistService();
})(typeof window !== 'undefined' ? window : global);


