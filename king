(function (global) {
    'use strict';

    var Zorio = global.Zorio = global.Zorio || {};

    function ZorioComponent(object) {
        var self = this;
        this._object = object || {};
        this._root = null;
        this._nav = null;
        this._view = (object && object.initialView) ? object.initialView : 'tv';
        this._clockTimer = null;
        this._splashTimer = null;
        this._tvView = new Zorio.TvView(this);
        this._playlistsView = new Zorio.PlaylistsView(this);

        this._onCatalogChanged = function () {
            self.renderTopFilters();
            if (self._view === 'tv' && self._root) {
                var shouldAutoSelect = !self._tvView._selectedChannel;
                self._tvView._renderChannels(shouldAutoSelect);
            } else if (self._view === 'playlists') {
                self._playlistsView.refreshView();
            }
        };

        this._onPlaylistsUpdated = function () {
            if (self._view === 'playlists') self._playlistsView.refreshView();
        };

        this._onEpgUpdated = function () {
            if (self._view === 'playlists') self._playlistsView.refreshView();
            else if (self._view === 'tv' && self._tvView._selectedChannel) {
                self._tvView._renderEpg(self._tvView._selectedChannel);
            }
        };

        this._onSettingsChanged = function (settings) {
            self._applyVisualSettings(settings);
        };
    }

    ZorioComponent.prototype._applyVisualSettings = function (settings) {
        if (!this._root) return;
        var s = settings || Zorio.Storage.getSettings();
        this._root.classList.toggle('zorio-compact', !!s.uiCompact);
        this._root.classList.toggle('zorio-no-anim', !s.uiAnimations);
    };

    ZorioComponent.prototype._runSplash = function () {
        if (!this._root) return;
        var splash = this._root.querySelector('[data-zorio-splash]');
        if (!splash) return;

        var settings = Zorio.Storage.getSettings();
        if (!settings.uiAnimations) {
            if (splash.parentNode) splash.parentNode.removeChild(splash);
            return;
        }

        this._splashTimer = setTimeout(function () {
            splash.classList.add('is-leaving');
            setTimeout(function () {
                if (splash && splash.parentNode) splash.parentNode.removeChild(splash);
            }, 440);
        }, 900);
    };

    ZorioComponent.prototype.renderTopFilters = function () {
        if (!this._root) return;
        var bar = this._root.querySelector('[data-zorio-filters]');
        if (!bar) return;

        var channelsForFilters = this._tvView.getChannelsForCurrentCountry();
        var favs = Zorio.Storage.getFavorites();
        var cats = Zorio.CatalogClassifier.buildTvCategories(channelsForFilters || [], favs);
        var activeCat = this._tvView.getCategory();

        var html = '';
        for (var i = 0; i < cats.length; i++) {
            var c = cats[i];
            var isAct = (this._view === 'tv' && c.id === activeCat);
            html += '<div class="zorio-filter-item zorio-focusable' + (isAct ? ' is-active' : '') + '" data-action="select-filter" data-cat="' + Zorio.Utils.escapeHtml(c.id) + '">' +
                '<span>' + Zorio.Utils.escapeHtml(c.label) + '</span>' +
                '<span class="zorio-filter-item__count">' + c.count + '</span>' +
            '</div>';
        }
        bar.innerHTML = html;

        var countryBtn = this._root.querySelector('[data-zorio-country-btn]');
        if (countryBtn) {
            var curCountry = this._tvView.getCountry();
            countryBtn.textContent = curCountry === 'ALL' ? 'Країна: Усі' : ('Країна: ' + Zorio.Utils.getCountryLabel(curCountry));
            countryBtn.classList.toggle('is-active', curCountry !== 'ALL');
        }

        var langBtn = this._root.querySelector('[data-zorio-lang-btn]');
        if (langBtn) {
            var curLang = this._tvView.getLanguage();
            langBtn.textContent = curLang === 'ALL' ? 'Мова: Усі' : ('Мова: ' + Zorio.Utils.getLanguageLabel(curLang));
            langBtn.classList.toggle('is-active', curLang !== 'ALL');
        }

        var qualBtn = this._root.querySelector('[data-zorio-quality-btn]');
        if (qualBtn) {
            var curQual = this._tvView.getQuality();
            qualBtn.textContent = curQual === 'ALL' ? 'Якість: Усі' : ('Якість: ' + curQual);
            qualBtn.classList.toggle('is-active', curQual !== 'ALL');
        }

        var plBtn = this._root.querySelector('[data-action="toggle-playlists"]');
        if (plBtn) plBtn.classList.toggle('is-active', this._view === 'playlists');
    };

    ZorioComponent.prototype.create = function () {
        var self = this;
        var wrap = document.createElement('div');
        wrap.innerHTML = Zorio.Templates.get('app');
        this._root = wrap.firstElementChild;
        this._applyVisualSettings();
        this._runSplash();

