    function getRouletteCacheKey() {
        var r = state.roulette;
        return [
            r.contentType,
            (r.genres || []).slice().sort().join(','),
            r.period,
            r.minRating,
            r.maxAgeYears,
            r.popularity,
            r.excludeWatched ? '1' : '0'
        ].join('|');
    }

    function fetchRouletteCandidates(onSuccess, onError) {
        var r = state.roulette;
        var key = getRouletteCacheKey();
        var watchedMap = r.excludeWatched ? getWatchedMap(state) : {};

        if (!rouletteCache[key]) {
            rouletteCache[key] = { items: [], totalPages: 12, fetchedPages: {} };
        }
        var entry = rouletteCache[key];

        function getAvailableFromCache() {
            var valid = [];
            for (var i = 0; i < entry.items.length; i++) {
                var c = entry.items[i];
                if (r.excludeWatched && watchedMap[String(c.id)]) continue;
                if (!rouletteSeen[cardKey(c)]) {
                    valid.push(c);
                }
            }
            return valid;
        }

        var ready = getAvailableFromCache();
        if (ready.length >= 8) {
            onSuccess(ready, entry.items);
            return;
        }

        var maxPage = Math.min(25, Math.max(1, entry.totalPages || 12));
        var pageToLoad = 1 + Math.floor(Math.random() * maxPage);
        if (entry.fetchedPages[pageToLoad]) {
            for (var p = 1; p <= maxPage; p++) {
                if (!entry.fetchedPages[p]) {
                    pageToLoad = p;
                    break;
                }
            }
        }
        entry.fetchedPages[pageToLoad] = true;

        var mType = r.contentType === 'all' ? (Math.random() < 0.5 ? 'movie' : 'tv') : r.contentType;
        var popOpt = POPULARITY_OPTIONS[0];
        for (var pi = 0; pi < POPULARITY_OPTIONS.length; pi++) {
            if (POPULARITY_OPTIONS[pi].id === r.popularity) {
                popOpt = POPULARITY_OPTIONS[pi];
                break;
            }
        }

        var withGenres = mapGenresForMediaType(r.genres, mType);

        CatalogService.fetchDiscover(network, {
            mediaType: mType,
            page: pageToLoad,
            minRating: r.minRating,
            period: r.period,
            maxAgeYears: r.maxAgeYears,
            withGenres: withGenres,
            sortBy: popOpt.sortBy,
            minVotes: popOpt.minVotes
        }, function (items, totalPages) {
            if (totalPages && totalPages > 0) entry.totalPages = totalPages;
            mergeUnique(entry.items, items);

            var available = getAvailableFromCache();
            if (!available.length && entry.items.length > 0) {
                rouletteSeen = {};
                available = getAvailableFromCache();
            }

            if (!available.length) {
                CatalogService.fetchDiscover(network, {
                    mediaType: mType,
                    page: 1 + Math.floor(Math.random() * 5),
                    minRating: 0,
                    period: 'all',
                    withGenres: withGenres,
                    sortBy: 'popularity.desc',
                    minVotes: 50
                }, function (fallbackItems) {
                    mergeUnique(entry.items, fallbackItems);
                    var fbReady = getAvailableFromCache();
                    if (fbReady.length) onSuccess(fbReady, entry.items);
                    else onError('По выбранным фильтрам не найдено фильмов в каталоге.');
                }, function () {
                    onError('Ошибка сети при обращении к каталогу TMDB.');
                });
                return;
            }

            onSuccess(available, entry.items);
        }, function () {
            if (ready.length) onSuccess(ready, entry.items);
            else onError('Ошибка сети при загрузке каталога TMDB.');
        });
    }

    function buildRouletteReel(pool, winnerCard) {
        var totalSlots = 32;
        var winnerIndex = 26;
        var reel = [];
        var source = pool && pool.length ? pool : [winnerCard];

        for (var i = 0; i < totalSlots; i++) {
            if (i === winnerIndex) {
                reel.push(winnerCard);
            } else {
                var rand = source[Math.floor(Math.random() * source.length)];
                if (source.length > 1 && rand && cardKey(rand) === cardKey(winnerCard)) {
                    rand = source[(i + 1) % source.length];
                }
                reel.push(rand || winnerCard);
            }
        }
        return { items: reel, winnerIndex: winnerIndex };
    }

