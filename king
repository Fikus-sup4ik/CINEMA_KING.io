        footer.append(openLeftBtn).append(skipBtn).append(openRightBtn);

        view.append(wrap).append(footer);
        body.empty().append(view);
        refreshFocus(elLeft);

        var unseenCount = 0;
        for (var i = 0; i < battlePool.length; i++) {
            if (!battleSeen[cardKey(battlePool[i])]) unseenCount++;
