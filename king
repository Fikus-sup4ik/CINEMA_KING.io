                isQuizLoading = true;
                body.html('<div class="ck-state-box"><div class="ck-spinner"></div><div>' + (isTvMode ? 'Загружаем сериалы и кадры из серий (TMDB Episode Stills)...' : 'Загружаем фильмы и фоновые арты (TMDB Backdrops)...') + '</div></div>');

                CatalogService.fetchDiscover(network, {
                    mediaType: isTvMode ? 'tv' : 'movie',
                    page: 1 + Math.floor(Math.random() * 6),
                    minRating: 7.0,
                    sortBy: 'popularity.desc',
                    minVotes: 400
                }, function (items) {
                    isQuizLoading = false;
                    mergeUnique(pool, items);
                    if (pool.length >= 4) {
                        if (activeTab === 'quiz') prepareQuizQuestion();
                    } else {
                        renderErrorState('Недостаточно данных в каталоге TMDB для запуска викторины.', function () {
                            renderQuiz();
                        });
                    }
                }, function () {
                    isQuizLoading = false;
                    renderErrorState('Ошибка сети при загрузке вопросов викторины.', function () {
                        renderQuiz();
                    });
                });
                return;
            }

            prepareQuizQuestion();
        }

        function prepareQuizQuestion() {
            var isTvMode = quizMode === 'tv_stills';
            var pool = isTvMode ? quizPoolTv : quizPoolMovie;

            var candidates = [];
            var i;
            for (i = 0; i < pool.length; i++) {
                if (!quizUsedIds[cardKey(pool[i])]) {
                    candidates.push(pool[i]);
                }
            }
            if (candidates.length < 4) {
                quizUsedIds = {};
                candidates = pool.slice();
            }

            var shuffled = shuffleArray(candidates);
            var target = shuffled[0];
            var distractors = shuffled.slice(1, 4);

            if (!target || distractors.length < 3) {
                renderErrorState('Недостаточно вариантов ответа для формирования вопроса.', function () {
                    quizPoolTv = [];
                    quizPoolMovie = [];
                    renderQuiz();
                });
                return;
            }

            isQuizLoading = true;
            body.html('<div class="ck-state-box"><div class="ck-spinner"></div><div>Проверяем наличие изображений в TMDB...</div></div>');

            function onImagesLoaded(imagesList) {
                isQuizLoading = false;
                if (activeTab !== 'quiz') return;

                if (!imagesList || !imagesList.length) {
                    quizUsedIds[cardKey(target)] = true;
                    for (var idx = pool.length - 1; idx >= 0; idx--) {
                        if (cardKey(pool[idx]) === cardKey(target)) {
                            pool.splice(idx, 1);
                            break;
                        }
                    }
                    if (pool.length >= 4) {
                        prepareQuizQuestion();
                    } else {
                        renderQuiz();
                    }
                    return;
                }

                quizUsedIds[cardKey(target)] = true;
                var pickedImage = imagesList[Math.floor(Math.random() * imagesList.length)];
                var options = shuffleArray([target].concat(distractors));
                drawQuizQuestion(target, pickedImage, options);
            }

            if (isTvMode) {
                CatalogService.fetchTvEpisodeStills(network, target, onImagesLoaded);
            } else {
                CatalogService.fetchMovieCleanBackdrops(network, target, onImagesLoaded);
            }
        }

        function drawQuizQuestion(target, imageObj, options) {
            var isTvMode = quizMode === 'tv_stills';
            var view = $('<div class="ck-view ck-quiz-wrap"></div>');

            var toolbar = $('<div class="ck-quiz-toolbar"></div>');
            var badgeHtml = isTvMode
                ? '<span class="ck-quiz-badge">TMDB: Episode Still</span>'
                : '<span class="ck-quiz-badge ck-quiz-badge--backdrop">TMDB: Backdrop (промо-фон)</span>';

            toolbar.append(
                '<div class="ck-quiz-head-left">' +
                    '<div class="ck-arena-title" style="font-size:1.15em;">Вопрос ' + quizRound + ' из ' + quizMaxRounds + ' • Счёт: ' + quizScore + '</div>' +
                    '<div class="ck-arena-meta">Рекорд: ' + state.quiz.bestScore + '</div>' +
                    badgeHtml +
                '</div>'
            );

            var modeChips = $('<div class="ck-chips"></div>');
            var tvChip = $('<div class="ck-chip selector' + (isTvMode ? ' is-selected' : '') + '">Сериалы (Stills)</div>');
            tvChip.on('hover:enter', function () {
                if (quizMode === 'tv_stills') return;
                quizMode = 'tv_stills';
                quizRound = 1;
                quizScore = 0;
                quizUsedIds = {};
                renderQuiz();
            });

            var movieChip = $('<div class="ck-chip selector' + (!isTvMode ? ' is-selected' : '') + '">Фильмы (Backdrops)</div>');
            movieChip.on('hover:enter', function () {
                if (quizMode === 'movie_backdrops') return;
                quizMode = 'movie_backdrops';
                quizRound = 1;
                quizScore = 0;
                quizUsedIds = {};
                renderQuiz();
            });

            modeChips.append(tvChip).append(movieChip);
            toolbar.append(modeChips);
            view.append(toolbar);

            var frameBox = $(
                '<div class="ck-quiz-frame-box">' +
                    '<img src="' + esc(imageObj.url) + '" alt="Изображение из TMDB">' +
                    '<div class="ck-quiz-frame-meta">' + esc(imageObj.meta) + '</div>' +
                '</div>'
            );

            frameBox.find('img').on('error', function () {
                if (activeTab === 'quiz') prepareQuizQuestion();
            });

            view.append(frameBox);

            var optsGrid = $('<div class="ck-quiz-options"></div>');
            var answered = false;

            for (var i = 0; i < options.length; i++) {
                (function (optCard) {
                    var label = optCard.title + (optCard.year ? ' (' + optCard.year + ')' : '');
                    var btn = $('<div class="ck-quiz-opt selector" title="' + esc(label) + '"><span>' + esc(label) + '</span></div>');
                    btn.on('hover:enter', function () {
                        if (answered) return;
                        answered = true;

                        var isRight = cardKey(optCard) === cardKey(target);
                        if (isRight) {
                            quizScore += 1;
                            btn.addClass('is-correct');
                            showToast('Верно! Это «' + target.title + '».');
                        } else {
                            btn.addClass('is-wrong');
                            optsGrid.find('.ck-quiz-opt').each(function (idx) {
                                if (cardKey(options[idx]) === cardKey(target)) {
                                    $(this).addClass('is-correct');
                                }
                            });
                            showToast('Неверно. Правильный ответ: «' + target.title + '».');
                        }

                        if (quizScore > state.quiz.bestScore) {
                            state.quiz.bestScore = quizScore;
                        }
                        StorageManager.save(state);

                        var nextDelay = isReducedMotion(state) ? 400 : 1350;
                        setTimeout(function () {
                            quizRound += 1;
                            if (activeTab === 'quiz') renderQuiz();
                        }, nextDelay);
                    });
                    optsGrid.append(btn);
                })(options[i]);
            }

            view.append(optsGrid);
            body.empty().append(view);
            refreshFocus(optsGrid.find('.selector').first());
        }

