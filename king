                        self._callbacks.onFavToggle(parseInt(favNode.getAttribute('data-fav-toggle'), 10));
                    }
                    return;
                }
                favNode = favNode.parentNode;
            }

            var target = self._findFocusable(ev.target);
            if (!target) return;
            self.focus(target, true);
            self.activate();
        };

        this._boundMouseOver = function (ev) {
            var target = self._findFocusable(ev.target);
            if (target && target !== self._current) {
                self.focus(target, true);
            }
        };

        this._root.addEventListener('click', this._boundClick, false);
        this._root.addEventListener('mouseover', this._boundMouseOver, false);
    };

    NavigationManager.prototype._findFocusable = function (node) {
        var el = node;
        while (el && el !== this._root) {
            if (el.classList && el.classList.contains('zorio-focusable')) {
                return el;
            }
            el = el.parentNode;
        }
        return null;
    };

    NavigationManager.prototype.getFocusables = function () {
        if (!this._root || !this._root.querySelectorAll) return [];
        var list = this._root.querySelectorAll('.zorio-focusable');
        var visible = [];
        for (var i = 0; i < list.length; i++) {
            var el = list[i];
            if (el.offsetWidth > 0 || el.offsetHeight > 0 || (el.getClientRects && el.getClientRects().length > 0)) {
                visible.push(el);
            }
        }
        return visible;
    };

    NavigationManager.prototype.focus = function (el, silentScroll) {
        if (!el) return;
        if (this._current && this._current !== el && this._current.classList) {
            this._current.classList.remove('zorio-focus');
        }
        this._current = el;
        if (el.classList) el.classList.add('zorio-focus');

        if (!silentScroll && typeof el.scrollIntoView === 'function') {
            try {
                el.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
            } catch (e) {
