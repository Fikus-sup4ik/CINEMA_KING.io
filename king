    function CinemaKingComponent(object) {
        var network = new Lampa.Reguest();
        var scroll = new Lampa.Scroll({ mask: true, over: true });
        var shell = $('<div class="ck-shell"></div>');
        var bgStage = $('<div class="ck-bg-stage"></div>');
        var html = $('<div class="ck-root"></div>');
        var contentWrap = $('<div class="ck-content"></div>');
        var topbar = $('<div class="ck-topbar"></div>');
        var body = $('<div class="ck-body"></div>');
        var footerSig = $('<div class="ck-signature-footer"></div>');
        var toastEl = $('<div class="ck-toast"></div>');

        var state = StorageManager.load();
        var backdropMgr = BackdropManager(bgStage, function () { return state; });

        var activeTab = 'home';
        var lastFocused = null;
        var toastTimer = null;

        // Сессионное состояние «Битвы фильмов»
        var battlePool = [];
        var battleSeen = {};
        var battlePage = 1;
        var sessionRound = 1;
        var currentPair = null;
        var isBattleLoading = false;
        var isAnimating = false;

        // Сессионное состояние «Царя горы»
        var kothPool = [];
        var kothSeen = {};
        var kothPage = 1;
        var currentChallenger = null;
        var isKothLoading = false;

        // Сессионное состояние «Кино-рулетки»
        var rouletteCache = {};
        var rouletteSeen = {};
        var roulettePreviewPool = [];
        var rouletteResult = null;
        var isRouletteSpinning = false;
        var rouletteRafId = null;

        // Сессионное состояние «Угадай по кадру»
        var quizMode = 'tv_stills';
        var quizRound = 1;
        var quizMaxRounds = 10;
        var quizScore = 0;
        var quizUsedIds = {};
        var quizPoolTv = [];
        var quizPoolMovie = [];
        var isQuizLoading = false;

        // Сессионное состояние «Подобрать под мой вкус»
        var wizardStep = 1;
        var wizardResults = [];
        var wizardSeenIds = {};
        var wizardPage = 1;
        var isWizardLoading = false;

        // Сессионное состояние «Рекомендации» и «Мои победители»
        var recsList = [];
        var recsPage = 1;
        var isRecsLoading = false;
        var winnersSort = 'date';
        var winnersQuery = '';

        function applyMotionClass() {
            if (state.settings.liteAnimations) shell.addClass('ck-lite-motion');
            else shell.removeClass('ck-lite-motion');
        }

        function applyStreamClass() {
            if (activeTab === 'roulette' && state.roulette.streamMode) {
                shell.addClass('is-stream');
            } else {
                shell.removeClass('is-stream');
            }
        }

        function stopRouletteAnimation() {
            if (rouletteRafId) {
                cancelAnimationFrame(rouletteRafId);
                rouletteRafId = null;
            }
            isRouletteSpinning = false;
        }

        function showToast(message) {
            if (!message) return;
            clearTimeout(toastTimer);
            toastEl.text(message).addClass('is-visible');
            toastTimer = setTimeout(function () {
                toastEl.removeClass('is-visible');
            }, 3200);
        }

        function updateCardBackdrop(card) {
            if (!card) return;
            var url = card.backdrop || CatalogService.getImageUrl(card.backdrop_path, 'w1280');
            if (url) {
                backdropMgr.stopSlideshow();
                backdropMgr.setBackdrop(url, card.title || '');
            }
        }

        function openLampaCard(item) {
            if (!item || !item.id) return;
            Lampa.Activity.push({
                url: '',
                component: 'full',
                id: item.id,
                method: item.media_type === 'tv' ? 'tv' : 'movie',
                card: {
                    id: item.id,
                    title: item.title,
                    name: item.title,
                    poster_path: item.poster_path || '',
                    backdrop_path: item.backdrop_path || '',
                    vote_average: item.rating || 0,
                    release_date: item.year ? item.year + '-01-01' : '',
                    first_air_date: item.year ? item.year + '-01-01' : '',
                    overview: item.overview || ''
                },
                source: 'tmdb'
            });
        }

        function ensureElementVisible(el) {
            if (!el || !el.length) return;
            try {
                scroll.update(el, true);
            } catch (e) {}

            var domNode = el[0];
            if (domNode && typeof domNode.scrollIntoView === 'function') {
                try {
                    domNode.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } catch (e) {
                    try { domNode.scrollIntoView(false); } catch (err) {}
                }
            }
        }

        function bindScrollFocus(container) {
            container.find('.selector').off('hover:focus.ck').on('hover:focus.ck', function () {
                lastFocused = this;
                ensureElementVisible($(this));
            });
        }

        function refreshFocus(preferredEl) {
            setTimeout(function () {
                bindScrollFocus(html);
                Lampa.Controller.collectionSet(html);
                var target = preferredEl && preferredEl.length ? preferredEl[0] : null;
                if (!target) {
                    var firstBodySelector = body.find('.selector').first();
                    target = firstBodySelector.length ? firstBodySelector[0] : html.find('.selector').first()[0];
                }
                if (target) {
                    lastFocused = target;
                    Lampa.Controller.collectionFocus(target, html);
                    ensureElementVisible($(target));
                }
            }, 40);
        }

        // ---------------------------------------------------------------------
        // ВЕРХНЯЯ ПАНЕЛЬ НАВИГАЦИИ И ПОДПИСЬ ANDRPROD
        // ---------------------------------------------------------------------

        function renderSignature() {
            var sig = state.signature;
            footerSig.empty().hide();

