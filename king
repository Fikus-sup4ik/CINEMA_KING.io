        function renderWinners() {
            var view = $('<div class="ck-view"></div>');

            if (!state.winners.length) {
                var empty = $(
                    '<div class="ck-state-box">' +
                        '<h3 style="margin:0 0 0.5em;">Список победителей пока пуст</h3>' +
