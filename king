(function (global) {
    'use strict';

    var Zorio = global.Zorio = global.Zorio || {};

    function EpgService() {
        this._net = new Zorio.NetworkClient();
        this._data = null;
        this._status = 'idle';
        this._error = '';
    }

    EpgService.prototype.getEffectiveUrl = function () {
        var custom = Zorio.Storage.getEpgUrl();
        return custom || (Zorio.DEFAULT_EPG_URL || '');
    };

    EpgService.prototype.getStatus = function () {
        return {
            status: this._status,
            error: this._error,
            url: this.getEffectiveUrl(),
            programmeCount: this._data ? this._data.programmeCount : 0
        };
    };

    EpgService.prototype.load = function (customUrl, cb) {
        var self = this;
        var url = Zorio.Utils.trim(customUrl || this.getEffectiveUrl());

        if (!url) {
            this._status = 'idle';
            this._error = '';
            this._data = null;
            if (cb) cb(false, 'URL телепрограми не вказано');
            return;
        }

        if (!Zorio.Utils.isValidUrl(url)) {
            this._status = 'error';
            this._error = 'Некоректна URL-адреса EPG';
            if (cb) cb(false, this._error);
            return;
        }

        // Instant EPG from SmartCache if available (never blocks UI)
        if (Zorio.smartCache) {
            var cachedEpg = Zorio.smartCache.loadEpgSnapshot(url);
            if (cachedEpg && cachedEpg.ok) {
                self._data = cachedEpg;
                self._status = 'ready';
                self._error = '';
                Zorio.events.emit('epg:updated', self.getStatus());
                if (!cachedEpg.isExpired) {
                    if (cb) cb(true, 'EPG з кешу: ' + cachedEpg.programmeCount);
                    return;
                }
            }
        }

        this._status = 'loading';
        this._error = '';
        Zorio.events.emit('epg:updated', this.getStatus());

        this._net.fetchMaybeGzipText(url, function (xmlText) {
            var parsed = Zorio.XMLTVParser.parse(xmlText);
            if (!parsed.ok) {
                self._status = 'error';
                self._error = parsed.error;
                self._data = null;
                Zorio.events.emit('epg:updated', self.getStatus());
                if (cb) cb(false, parsed.error);
                return;
            }
            self._data = parsed;
            self._status = 'ready';
            self._error = '';
            if (Zorio.smartCache) Zorio.smartCache.saveEpgSnapshot(parsed, url);
            Zorio.Storage.set(Zorio.Storage.KEYS.EPG_UPDATED, Date.now());
            Zorio.events.emit('epg:updated', self.getStatus());
            if (cb) cb(true, 'Завантажено передач: ' + parsed.programmeCount);
        }, function (errMsg) {
            self._status = 'error';
            self._error = errMsg || 'Не вдалося завантажити EPG';
            Zorio.events.emit('epg:updated', self.getStatus());
            if (cb) cb(false, self._error);
        }, 30000);
    };

    EpgService.prototype.setXmlData = function (parsed) {
        this._data = parsed;
        this._status = parsed && parsed.ok ? 'ready' : 'error';
        this._error = parsed && parsed.error ? parsed.error : '';
    };

    /**
     * Strict XMLTV matching:
     * 1. Exact tvg-id / rawTvgId match.
     * 2. Careful exact normalized display-name match (length >= 2) with country-suffix compatibility check
     *    so we never display EPG from another channel or country.
     */
    EpgService.prototype._isCountryCompatible = function (channel, epgCid) {
        if (!channel || !channel.country || channel.country === 'INT') return true;
        var m = String(epgCid || '').toLowerCase().match(/\.([a-z]{2})$/);
        if (!m) return true;
        return m[1].toUpperCase() === String(channel.country).toUpperCase();
    };

    EpgService.prototype._resolveChannelId = function (channel) {
        if (!this._data || !channel) return '';
        var progs = this._data.programmesByChannel;
        if (channel.tvgId && progs[channel.tvgId]) return channel.tvgId;
        if (channel.rawTvgId && progs[channel.rawTvgId]) return channel.rawTvgId;

        var normTvg = Zorio.Utils.normalizeKey(channel.tvgName);
        if (normTvg && normTvg.length >= 2) {
            var cid1 = this._data.nameToId[normTvg];
            if (cid1 && progs[cid1] && this._isCountryCompatible(channel, cid1)) return cid1;
        }

        var normName = Zorio.Utils.normalizeKey(channel.name);
        if (normName && normName.length >= 2) {
            var cid2 = this._data.nameToId[normName];
            if (cid2 && progs[cid2] && this._isCountryCompatible(channel, cid2)) return cid2;
        }

        return '';
    };

    EpgService.prototype.getChannelProgram = function (channel, nowMs) {
        var now = nowMs || Date.now();
        var empty = { hasEpg: false, current: null, next: null, upcoming: [], progress: 0 };

        var cid = this._resolveChannelId(channel);
        if (!cid) return empty;

        var list = this._data.programmesByChannel[cid] || [];
        if (!list.length) return empty;

        var current = null;
        var next = null;
        var upcoming = [];
        var horizon = now + 6 * 3600 * 1000;

        for (var i = 0; i < list.length; i++) {
            var p = list[i];
            if (!current && p.start <= now && p.stop > now) {
                current = p;
            } else if (p.start >= now) {
                if (!next) next = p;
                if (p.start <= horizon && upcoming.length < 5) upcoming.push(p);
            }
        }

        var progress = 0;
        if (current && current.stop > current.start) {
            progress = Math.max(0, Math.min(100, Math.round(((now - current.start) / (current.stop - current.start)) * 100)));
        }

        return { hasEpg: !!(current || next), current: current, next: next, upcoming: upcoming, progress: progress };
    };

    EpgService.prototype.destroy = function () {
        this._net.clear();
    };

    Zorio.EpgService = EpgService;
    Zorio.epgService = new EpgService();
})(typeof window !== 'undefined' ? window : global);


