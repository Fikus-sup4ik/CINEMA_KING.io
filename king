            var isVideo = /^(avc1|avc3|hev1|hvc1|vp09|vp9|vp8|av01|mp4v)/i.test(lower);

            if (isAudio) {
                hasAudioTag = true;
                if (mse && !mse.isTypeSupported('audio/mp4; codecs="' + codec + '"')) audioSupported = false;
            } else if (isVideo) {
                if (mse && !mse.isTypeSupported('video/mp4; codecs="' + codec + '"')) videoSupported = false;
