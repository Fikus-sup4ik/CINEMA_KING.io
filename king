        this._app.renderTopFilters();
        this._renderChannels(false);
        if (this._selectedChannel && this._selectedChannel.key === ch.key) this._renderEpg(ch);
    };

    TvView.prototype.onFocusElement = function (el) {
        if (!el) return;
        if (el.getAttribute('data-action') === 'channel-item') {
            var idx = parseInt(el.getAttribute('data-index'), 10);
            var ch = this._filteredChannels[idx];
            if (ch) this.selectChannel(ch, false);
        }
    };

    TvView.prototype.onAction = function (el) {
        var action = el.getAttribute('data-action');

        if (action === 'retry-default-playlist') {
            var def = Zorio.playlistService.ensureDefaultPlaylist();
            if (def) {
                Zorio.playlistService.refreshPlaylist(def.id);
                this._renderChannels(true);
            }
            return true;
        }

        if (action === 'channel-item') {
            var idx = parseInt(el.getAttribute('data-index'), 10);
            var ch = this._filteredChannels[idx];
            if (!ch) return true;
            this.selectChannel(ch, false);
            this.openFullscreen(ch);
            return true;
        }

        if (action === 'fullscreen') {
            if (this._selectedChannel) this.openFullscreen(this._selectedChannel);
            return true;
        }

        if (action === 'toggle-fav') {
            if (this._selectedChannel) {
                var added = Zorio.Storage.toggleFavorite(this._selectedChannel.key);
                if (typeof Lampa !== 'undefined' && Lampa.Noty) {
                    Lampa.Noty.show(added ? 'Додано в обрані канали' : 'Видалено з обраних');
                }
                this._app.renderTopFilters();
                this._renderChannels(false);
                this._renderEpg(this._selectedChannel);
            }
            return true;
        }

        return false;
    };

    TvView.prototype._updateStageCard = function (channel) {
        if (!this._root || !channel) return;
        var badge = this._root.querySelector('[data-zorio-stream-status]');
        var msg = this._root.querySelector('[data-zorio-preview-msg]');
        var srcCount = Array.isArray(channel.sources) ? channel.sources.length : (Array.isArray(channel.streams) ? channel.streams.length : 1);
        if (badge) {
            var q = channel.qualityTag ? (channel.qualityTag + ' • ') : '';
            badge.textContent = q + srcCount + ' джер.';
        }
        if (msg) {
            msg.textContent = channel.name + ' — натисніть OK для запуску у плеєрі Lampa';
        }
    };

    TvView.prototype.openFullscreen = function (channel) {
        var self = this;
        if (!channel) return;
        Zorio.playerService.playChannel(channel, this._filteredChannels, function () {
            self._app.restoreFocus();
        });
    };

    TvView.prototype.unmount = function () {
        if (this._epgTimer) {
            clearInterval(this._epgTimer);
            this._epgTimer = null;
        }
        Zorio.events.off('channel:health', this._onChannelHealth);
        
        this._root = null;
    };

    Zorio.TvView = TvView;
})(typeof window !== 'undefined' ? window : global);


