    function renderQuiz() {
        if (isQuizLoading) return;

        if (quizRound > quizMaxRounds) {
            renderQuizComplete();
            return;
        }

        var isTvMode = quizMode === 'tv_stills';
        var pool = isTvMode ? quizPoolTv : quizPoolMovie;

        if (pool.length < 8) {
            isQuizLoading = true;
            body.html('<div class="ck-state-box"><div class="ck-spinner"></div><div>' + (isTvMode ? 'Загружаем сериалы и кадры из серий (TMDB Episode Stills)...' : 'Загружаем фильмы и фоновые арты (TMDB Backdrops)...') + '</div></div>');

            CatalogService.fetchDiscover(network, {
                mediaType: isTvMode ? 'tv' : 'movie',
                page: 1 + Math.floor(Math.random() * 6),
                minRating: 7.0,
                sortBy: 'popularity.desc',
                minVotes: 400
            }, function (items) {
                isQuizLoading = false;
                mergeUnique(pool, items);
                if (pool.length >= 4) {
                    if (activeTab === 'quiz') prepareQuizQuestion();
                } else {
                    renderErrorState('Недостаточно данных в каталоге TMDB для запуска викторины.', function () {
                        renderQuiz();
                    });
                }
            }, function () {
                isQuizLoading = false;
                renderErrorState('Ошибка сети при загрузке вопросов викторины.', function () {
                    renderQuiz();
                });
            });
            return;
        }

        prepareQuizQuestion();
    }

    function prepareQuizQuestion() {
        var isTvMode = quizMode === 'tv_stills';
        var pool = isTvMode ? quizPoolTv : quizPoolMovie;

        var candidates = [];
        var i;
        for (i = 0; i < pool.length; i++) {
            if (!quizUsedIds[cardKey(pool[i])]) {
                candidates.push(pool[i]);
            }
        }
        if (candidates.length < 4) {
            quizUsedIds = {};
            candidates = pool.slice();
        }

        var shuffled = shuffleArray(candidates);
        var target = shuffled[0];
        var distractors = shuffled.slice(1, 4);

        if (!target || distractors.length < 3) {
            renderErrorState('Недостаточно вариантов ответа для формирования вопроса.', function () {
                quizPoolTv = [];
                quizPoolMovie = [];
                renderQuiz();
            });
            return;
        }

        isQuizLoading = true;
        body.html('<div class="ck-state-box"><div class="ck-spinner"></div><div>Проверяем наличие изображений в TMDB...</div></div>');

        function onImagesLoaded(imagesList) {
            isQuizLoading = false;
            if (activeTab !== 'quiz') return;

            if (!imagesList || !imagesList.length) {
                quizUsedIds[cardKey(target)] = true;
                for (var idx = pool.length - 1; idx >= 0; idx--) {
                    if (cardKey(pool[idx]) === cardKey(target)) {
                        pool.splice(idx, 1);
                        break;
                    }
                }
                if (pool.length >= 4) {
                    prepareQuizQuestion();
                } else {
                    renderQuiz();
                }
                return;
            }

            quizUsedIds[cardKey(target)] = true;
            var pickedImage = imagesList[Math.floor(Math.random() * imagesList.length)];
            var options = shuffleArray([target].concat(distractors));
            drawQuizQuestion(target, pickedImage, options);
        }

        if (isTvMode) {
            CatalogService.fetchTvEpisodeStills(network, target, onImagesLoaded);
        } else {
            CatalogService.fetchMovieCleanBackdrops(network, target, onImagesLoaded);
        }
    }

    function drawQuizQuestion(target, imageObj, options) {
        var isTvMode = quizMode === 'tv_stills';
        var view = $('<div class="ck-view ck-quiz-wrap"></div>');

        var toolbar = $('<div class="ck-quiz-toolbar"></div>');
