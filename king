        getImageUrl: function (path, size) {
            if (!path) return '';
            var clean = path.charAt(0) === '/' ? path : '/' + path;
            try {
                if (Lampa.TMDB && typeof Lampa.TMDB.image === 'function') {
                    return Lampa.TMDB.image('t/p/' + (size || 'w500') + clean);
