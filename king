(function (global) {
    'use strict';

    var Zorio = global.Zorio = global.Zorio || {};

    function DiagnosticService() {
        this._records = {}; // channelKey -> diagnostic record
    }

    DiagnosticService.prototype.record = function (channel, details) {
        if (!channel || !channel.key) return;
        var d = details || {};
        var prev = this._records[channel.key] || {};

        this._records[channel.key] = {
            key: channel.key,
            name: channel.name || prev.name || 'Без назви',
            source: d.source || prev.source || (channel.streams && channel.streams[0] ? channel.streams[0].sourceName : ''),
            url: d.url || prev.url || channel.url || '',
            httpResult: d.httpResult !== undefined ? d.httpResult : (prev.httpResult || 'Не перевірявся'),
            hlsResult: d.hlsResult !== undefined ? d.hlsResult : (prev.hlsResult || 'Не перевірявся'),
            playbackResult: d.playbackResult !== undefined ? d.playbackResult : (prev.playbackResult || 'unknown'),
            hasAudio: d.hasAudio !== undefined ? d.hasAudio : (prev.hasAudio !== undefined ? prev.hasAudio : null),
            errorCode: d.errorCode !== undefined ? d.errorCode : (prev.errorCode || ''),
            errorReason: d.errorReason !== undefined ? d.errorReason : (prev.errorReason || ''),
            attempts: d.attempts !== undefined ? d.attempts : (prev.attempts || 0),
            alternativesCount: d.alternativesCount !== undefined
                ? d.alternativesCount
                : (Array.isArray(channel.streams) ? Math.max(0, channel.streams.length - 1) : 0),
            alternativesTried: d.alternativesTried !== undefined ? d.alternativesTried : (prev.alternativesTried || 0),
            updatedAt: Date.now()
        };
    };

    DiagnosticService.prototype.getChannelRecord = function (channelKey) {
        return this._records[channelKey] || null;
    };

    DiagnosticService.prototype.getAllRecords = function () {
        var keys = Object.keys(this._records);
        var list = [];
        for (var i = 0; i < keys.length; i++) {
            list.push(this._records[keys[i]]);
        }
        return list;
    };

    DiagnosticService.prototype.getSummary = function (allChannels) {
        var catalog = Array.isArray(allChannels)
            ? allChannels
            : (Zorio.playlistService ? (Zorio.playlistService.getCatalog().channels || []) : []);

        var summary = {
            totalChannels: catalog.length,
            testedChannels: 0,
            working: 0,
            temporarilyUnavailable: 0,
            geoBlocked: 0,
            unsupportedCodec: 0,
            noAudio: 0,
            withoutAlternatives: 0
        };

        for (var i = 0; i < catalog.length; i++) {
            var ch = catalog[i];
            var streamCount = Array.isArray(ch.streams) ? ch.streams.length : (ch.url ? 1 : 0);
            if (streamCount <= 1) summary.withoutAlternatives += 1;

            var rec = this._records[ch.key];
            if (!rec) continue;
            summary.testedChannels += 1;

            if (rec.playbackResult === 'working') {
                summary.working += 1;
            } else if (rec.playbackResult === 'no_audio') {
                summary.noAudio += 1;
            } else if (rec.errorCode === 'geo_restricted' || rec.errorCode === 'auth_required') {
                summary.geoBlocked += 1;
            } else if (rec.errorCode === 'unsupported_video_codec' || rec.errorCode === 'unsupported_audio_codec') {
                summary.unsupportedCodec += 1;
            } else if (rec.playbackResult === 'temp_unavailable') {
                summary.temporarilyUnavailable += 1;
            }
        }

        return summary;
    };

    DiagnosticService.prototype.clear = function () {
        this._records = {};
    };

    Zorio.DiagnosticService = DiagnosticService;
    Zorio.diagnostics = new DiagnosticService();
})(typeof window !== 'undefined' ? window : global);


